    "node_id": "C_kwDOUZ19ENoAKDRlZWI4MTdmZTJmY2Q4YmE4MjhhZmM0OWNkOWNjYTdjODJiY2E0MmY",
    "commit": {
      "author": {
        "name": "Gabe Zimbric",
        "email": "10481275+gzimbric@users.noreply.github.com",
        "date": "2026-10-09T06:03:48Z"
      },
      "committer": {
        "name": "Gabe Zimbric",
        "email": "10481275+gzimbric@users.noreply.github.com",
        "date": "2026-10-09T06:05:47Z"
      },
      "message": "ntdll: Reject ARM64 user callbacks whose arguments would overflow the stack.\n\nA user-mode callback whose argument block does not fit below the current\nstack pointer corrupted the thread stack; seen with a 72 MB drag-and-drop\npayload. The bounds check applies while the thread runs on the stack its\nTEB describes. On a stack of its own, as with fibers and job systems, the\npayload is capped at 1 MB instead of being rejected.",
      "tree": {
        "sha": "8136f1127aee8d0e523701622521d89202cd8020",
        "url": "https://api.github.com/repos/gzimbric/wine-arm64-macos/git/trees/8136f1127aee8d0e523701622521d89202cd8020"
