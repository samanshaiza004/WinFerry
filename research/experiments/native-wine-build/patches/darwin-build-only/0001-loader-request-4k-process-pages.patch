+#if defined(__APPLE__) && defined(__aarch64__)
+/* Re-exec once in a 4 KB-page process before Wine reserves guest address space. */
+static void ensure_4k_pages( char *argv[] )
+{
+    static const char marker[] = "WINFERRY_PAGE_SIZE_REEXEC_PID";
+    const char *previous, *self;
+    char pid[32];
+    posix_spawnattr_t attr;
+    int error;
+
+    if (getpagesize() == 4096)
+    {
+        if (getenv( marker )) unsetenv( marker );
+        return;
+    }
+
+    if (!__builtin_available(macOS 26.0, *))
+    {
+        fprintf( stderr, "wine: 4 KB process pages require macOS 26 or newer\n" );
+        exit(1);
+    }
+
+    snprintf( pid, sizeof(pid), "%ld", (long)getpid() );
+    previous = getenv( marker );
+    if (previous && !strcmp( previous, pid ))
+    {
+        fprintf( stderr, "wine: re-exec returned without switching to 4 KB pages\n" );
+        exit(1);
+    }
+
+    self = get_self_exe();
+    if (!self)
+    {
+        fprintf( stderr, "wine: cannot resolve executable path for 4 KB re-exec\n" );
+        exit(1);
+    }
+    if (setenv( marker, pid, 1 ))
+    {
+        perror( "wine: cannot set 4 KB re-exec guard" );
+        exit(1);
+    }
+
+    error = posix_spawnattr_init( &attr );
+    if (error)
+    {
+        fprintf( stderr, "wine: posix_spawnattr_init failed: %s\n", strerror( error ) );
+        exit(1);
+    }
+    error = posix_spawnattr_setflags( &attr, POSIX_SPAWN_SETEXEC );
+    if (!error) error = posix_spawnattr_set_4k_page_size_np( &attr );
+    if (!error) error = posix_spawn( NULL, self, NULL, &attr, argv, environ );
+    posix_spawnattr_destroy( &attr );
+    if (error)
+    {
+        fprintf( stderr, "wine: 4 KB process re-exec failed: %s\n", strerror( error ) );
+        exit(1);
+    }
+
+    /* POSIX_SPAWN_SETEXEC replaces this process; reaching here is unexpected. */
+    fprintf( stderr, "wine: 4 KB process re-exec returned unexpectedly\n" );
+    exit(1);
+}
+#endif
